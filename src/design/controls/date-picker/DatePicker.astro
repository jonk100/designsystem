---
/**
 * src/design/controls/date-picker/DatePicker.astro
 * A styled date picker input wrapper for native browser calendar fields.
 * - Wraps a native calendar picker with standard control states and BEM styles.
 * @props (local): size, variant, disabled, readonly, invalid, name, value
 * @props (global): class, class:list, animate, onScroll, style
 */

import type { ControlComponentProps } from "@/design/controls/controls.types";
import { mergeClasses, mergeStyles } from "@/design/shared";
import "./DatePicker.css";

export interface Props extends ControlComponentProps, Omit<import("astro/types").HTMLAttributes<"input">, keyof ControlComponentProps> {}

const {
  size = "md",
  variant = "outline",
  disabled = false,
  readonly = false,
  invalid = false,
  name,
  value,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  "datepicker-component",
  `datepicker-component--${size}`,
  `datepicker-component--${variant}`,
  disabled && "is-disabled",
  readonly && "is-readonly",
  invalid && "is-invalid",
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles("", Astro.props);
---

<input
  type="date"
  name={name}
  value={value}
  disabled={disabled}
  readonly={readonly}
  class:list={finalClasses}
  style={finalStyles}
  aria-invalid={invalid ? "true" : undefined}
  {...rest}
/>
