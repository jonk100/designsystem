---
/**
 * src/design/controls/collapsible/Collapsible.astro
 * An interactive disclosure component that toggles visibility of its content.
 * - Uses native <details> and <summary> for accessibility.
 * - Bypasses flexbox bugs by wrapping contents in a block div.
 * @props (local): title, open
 * @props (global): class, class:list, animate, effects, bg
 */
import type { BaseComponentProps } from "@/design/shared/props";
import type { SpacingScale } from "@/design/shared/types";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import Text from "@/design/typography/text/Text.astro";
import Icon from "@/design/display/icon/Icon.astro";
import Inline from "@/design/layout/inline/Inline.astro";
import Paper from "@/design/surfaces/paper/Paper.astro";
import type { HTMLAttributes } from "astro/types";
import "./Collapsible.css";

export interface Props
  extends
    BaseComponentProps,
    Omit<HTMLAttributes<"details">, keyof BaseComponentProps> {
  title?: string;
  open?: boolean;
  /** Space between the summary and the content */
  gap?: SpacingScale;
}

const {
  title,
  open = false,
  gap,
  class: className,
  "class:list": classList,
  style,
  ...rest
} = Astro.props;

const classes = ["collapsible"];

const finalClasses = mergeClasses(classes, Astro.props);
const customGapStyle = gap ? `--collapsible-gap: var(--sp-${gap});` : "";
const finalStyles = mergeStyles(customGapStyle, Astro.props);
---

<Paper padding="sm" class="collapsible__summary-paper">
  <details class:list={finalClasses} style={finalStyles} open={open} {...rest}>
    <summary class="collapsible__summary">
      <Inline
        y="center"
        x="between"
        wrap={false}
        gap="md"
        class="collapsible__summary-inner"
      >
        {
          title && (
            <Text as="span" class="collapsible__title">
              {title}
            </Text>
          )
        }
        <slot name="summary" />
        <Icon name="chevron-down" size="lg" class="collapsible__icon" />
      </Inline>
    </summary>
    <div class="collapsible__content">
      <slot />
    </div>
  </details>
</Paper>
