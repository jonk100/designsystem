---
/**
 * src/design/media/gallery/GalleryItem.astro
 *
 * An individual item within a Gallery. Renders an Image with an optional
 * hover overlay and caption reveal.
 *
 * When `lightbox` is true, clicking the item dispatches a `lightbox:open`
 * custom DOM event with the full image set and the current index as payload.
 * The Lightbox controller listens for this event — GalleryItem does not
 * import or depend on Lightbox directly.
 *
 * Can be used standalone inside a Gallery slot, or rendered automatically
 * by Gallery when the `images` data array prop is provided.
 *
 * @props (local): src, alt, caption, index, total, galleryId, lightbox, allImages
 * @props (global): class, class:list, style
 */

import type { BaseComponentProps } from '@/design/shared/props';
import { mergeClasses, mergeStyles } from '@/design/shared/functions';
import Image from '@/design/media/image/Image.astro';
import type { GalleryImage } from './Gallery.types';
import { LIGHTBOX_OPEN_EVENT } from './Gallery.consts';
import './GalleryItem.css';

// ---------------------------------------------------------------------------
// Props interface
// ---------------------------------------------------------------------------

export interface Props
  extends BaseComponentProps,
    Omit<import('astro/types').HTMLAttributes<'div'>, keyof BaseComponentProps> {
  /** Image source URL. */
  src: string;
  /** Alt text for the image. Required for accessibility. */
  alt: string;
  /** Optional caption shown in the hover overlay and in the Lightbox. */
  caption?: string;
  /**
   * Zero-based index of this item within its Gallery.
   * Used to set the correct starting position when opening Lightbox.
   */
  index?: number;
  /** Total number of items in the Gallery. Used for aria-label. */
  total?: number;
  /** The parent Gallery's ID. Passed through to the lightbox:open event. */
  galleryId?: string;
  /**
   * When true, the item is interactive: hover overlay shows, click dispatches
   * a `lightbox:open` event.
   * @default false
   */
  lightbox?: boolean;
  /**
   * The full array of images in the parent Gallery.
   * Passed through in the `lightbox:open` event payload so the Lightbox
   * can build its navigation set.
   */
  allImages?: GalleryImage[];
}

// ---------------------------------------------------------------------------
// Destructure props
// ---------------------------------------------------------------------------

const {
  src,
  alt,
  caption,
  index = 0,
  total = 1,
  galleryId = '',
  lightbox = false,
  allImages = [],
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

// ---------------------------------------------------------------------------
// Build classes
// ---------------------------------------------------------------------------

const classes = [
  'gallery-item',
  lightbox && 'gallery-item--interactive',
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles('', Astro.props);

// ---------------------------------------------------------------------------
// Aria label for screen readers
// ---------------------------------------------------------------------------

const ariaLabel = lightbox
  ? `Open image ${index + 1} of ${total}${caption ? `: ${caption}` : ''}`
  : undefined;
---

<div
  class:list={finalClasses}
  style={finalStyles}
  role={lightbox ? 'button' : undefined}
  tabindex={lightbox ? 0 : undefined}
  aria-label={ariaLabel}
  data-gallery-item
  data-index={index}
  data-gallery-id={galleryId || undefined}
  {...rest}
>
  <Image
    src={src}
    alt={alt}
    ratio="auto"
    fit="cover"
    class="gallery-item__image"
  />

  {(caption || lightbox) && (
    <div class="gallery-item__overlay" aria-hidden="true">
      {caption && <p class="gallery-item__caption">{caption}</p>}
      {lightbox && (
        <span class="gallery-item__zoom-icon">
          <!-- Inline SVG zoom icon; no external dependency. -->
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="11" cy="11" r="8" />
            <line x1="21" y1="21" x2="16.65" y2="16.65" />
            <line x1="11" y1="8" x2="11" y2="14" />
            <line x1="8" y1="11" x2="14" y2="11" />
          </svg>
        </span>
      )}
    </div>
  )}
</div>

{lightbox && (
  <script define:vars={{ index, galleryId, allImages, LIGHTBOX_OPEN_EVENT }}>
    /**
     * GalleryItem inline script.
     * Scoped to this item; runs once per item on page load.
     * Dispatches a `lightbox:open` CustomEvent when the item is activated.
     */
    (function () {
      /** @type {HTMLElement | null} */
      const item = document.querySelector(
        `[data-gallery-id="${galleryId}"][data-index="${index}"]`
      );

      if (!item) return;

      /**
       * Dispatches the lightbox:open event with the full image set and index.
       */
      function openLightbox() {
        window.dispatchEvent(
          new CustomEvent(LIGHTBOX_OPEN_EVENT, {
            detail: {
              images: allImages,
              index: index,
              galleryId: galleryId,
            },
          })
        );
      }

      item.addEventListener('click', openLightbox);

      item.addEventListener('keydown', (/** @type {KeyboardEvent} */ e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openLightbox();
        }
      });
    })();
  </script>
)}
