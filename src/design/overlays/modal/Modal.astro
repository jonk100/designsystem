---
/**
 * src/design/overlays/modal/Modal.astro
 * A declarative slot-driven Modal component utilizing native <dialog>.
 * - Supports customized sizing and layout centering variants.
 * - Programmatically opens/closes via modal:open/close custom events.
 * - Handles backdrop dismissals and traps focus natively.
 * @props (local): id, title, size, variant, closeOnBackdrop
 * @props (global): class, class:list, style, animate
 */

import type { BaseComponentProps } from "@/design/shared/props";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import { OVERLAY_SIZE_CLASS_MAP, MODAL_VARIANT_CLASS_MAP } from "@/design/overlays/overlays.maps";
import type { OverlaySize, ModalVariant } from "@/design/overlays/overlays.types";
import type { HTMLAttributes } from "astro/types";
import "@/design/overlays/overlays.css";
import "./Modal.css";

export interface Props extends BaseComponentProps, Omit<HTMLAttributes<"dialog">, keyof BaseComponentProps> {
  /** Uniquely identifies this modal for event triggers */
  id: string;
  /** Modal header title text */
  title?: string;
  /** Sizing variant of the modal */
  size?: OverlaySize;
  /** Visual placement variant of the modal */
  variant?: ModalVariant;
  /** Whether clicking the backdrop closes the modal */
  closeOnBackdrop?: boolean;
}

const {
  id,
  title,
  size = "md",
  variant = "default",
  closeOnBackdrop = true,
  class: className,
  "class:list": classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  "modal-component",
  size && OVERLAY_SIZE_CLASS_MAP[size],
  variant && MODAL_VARIANT_CLASS_MAP[variant],
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles("", Astro.props);
---

<dialog
  id={id}
  class:list={finalClasses}
  style={finalStyles}
  data-close-on-backdrop={closeOnBackdrop ? "true" : "false"}
  {...rest}
>
  <div class="modal__card" role="document">
    <div class="modal__header">
      {title && <h3 class="modal__title">{title}</h3>}
      <button
        type="button"
        class="modal__close-btn"
        aria-label="Close modal"
        data-modal-close={id}
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    
    <div class="modal__body">
      <slot />
    </div>

    {Astro.slots.has("actions") && (
      <div class="modal__actions">
        <slot name="actions" />
      </div>
    )}
  </div>
</dialog>

<script>
  const setupModals = () => {
    const dialogs = document.querySelectorAll(".modal-component") as NodeListOf<HTMLDialogElement>;

    dialogs.forEach((dialog) => {
      const id = dialog.id;
      if (!id) return;

      // Listen to close buttons inside
      const closeButtons = dialog.querySelectorAll(`[data-modal-close="${id}"]`);
      closeButtons.forEach((btn) => {
        btn.addEventListener("click", () => dialog.close());
      });

      // Handle backdrop clicking to dismiss
      const closeOnBackdrop = dialog.getAttribute("data-close-on-backdrop") === "true";
      if (closeOnBackdrop) {
        dialog.addEventListener("click", (e) => {
          const rect = dialog.getBoundingClientRect();
          const isInDialog = (
            rect.top <= e.clientY &&
            e.clientY <= rect.top + rect.height &&
            rect.left <= e.clientX &&
            e.clientX <= rect.left + rect.width
          );
          if (!isInDialog) {
            dialog.close();
          }
        });
      }
    });

    // Listen for custom trigger events on window
    window.addEventListener("modal:open", (event: any) => {
      const { id } = event.detail || {};
      const dialog = document.getElementById(id) as HTMLDialogElement;
      if (dialog && typeof dialog.showModal === "function") {
        dialog.showModal();
      }
    });

    window.addEventListener("modal:close", (event: any) => {
      const { id } = event.detail || {};
      const dialog = document.getElementById(id) as HTMLDialogElement;
      if (dialog && typeof dialog.close === "function") {
        dialog.close();
      }
    });
  };

  // Setup listeners on DOM load and Astro view transitions
  setupModals();
  document.addEventListener("astro:page-load", setupModals);
</script>
