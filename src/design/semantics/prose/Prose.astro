---
/**
 * src/design/semantics/prose/Prose.astro
 * A container for formatting rich text content (like markdown).
 * - Applies consistent spacing and typography styles to children elements.
 * - Configurable max-width for readability.
 * @props (local): as, fs, ws, ff, wrap, tone, maxWidth, bold, italic, underline, strikethrough, uppercase, lowercase
 * @props (global): class, class:list, animate, effects
 */
import type { FontSize, TextTone, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { ProseMaxWidth } from '../types';
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import '../../typography/typography.css';
import './Prose.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'div'>, keyof BaseComponentProps> {
  /**
   * The HTML element to render
   * @default 'div'
   */
  as?: 'div' | 'article' | 'section';
  
  /**
   * Font size of the prose content
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Maximum width constraint
   */
  maxWidth?: ProseMaxWidth;
  
  /**
   * Standard boolean typography styles
   */
}

const {
  as: Element = 'div',
  fs,
  tone,
  maxWidth = 'lg',
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'prose',
  fs && `prose--size-${fs}`,
  tone && `prose--tone-${tone}`,
  maxWidth && maxWidth !== 'none' && `prose--max-width-${maxWidth}`,
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];



const styles = combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase });

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<Element class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Element>