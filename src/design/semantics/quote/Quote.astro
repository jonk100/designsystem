---
/**
 * src/design/semantics/quote/Quote.astro
 * A semantic quotation component.
 * - Supports block, inline, and pull quote styles via the `variant` prop.
 * - Semantically wraps text in `<q>` or `<blockquote>` depending on the variant.
 * @props (local): variant, fs, ws, ff, wrap, tone, xa, fw, cite, author, bold, italic, underline, strikethrough, uppercase, lowercase
 * @props (global): class, class:list, animate, effects
 */
import type { FontSize, TextTone, XAlign, FontFamily, WhiteSpace, FontStyleProps, FontWeight } from "../../shared/types";
import type { HTMLAttributes } from "astro/types";
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import type { QuoteVariant } from '../types';

import '../../typography/typography.css';
import './Quote.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'blockquote'>, keyof BaseComponentProps> {
  /**
   * Quote variant type
   */
  variant?: QuoteVariant;

  /**
   * Font size of the quote
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;

  /**
   * Color tone of the text
   */
  tone?: TextTone;

  /**
   * Horizontal text alignment
   */
  xa?: XAlign;

  /**
   * Font weight
   */
  fw?: FontWeight;

  /**
   * Standard boolean typography styles
   */

  /**
   * Citation URL
   */
  cite?: string;

  /**
   * Author of the quote (only shown for block/pull variants)
   */
  author?: string;
}

const {
  variant = "inline",
  fs,
  tone,
  xa,
  fw,
  bold = false,
  italic = variant === "inline",
  underline = false,
  strikethrough = false,
  cite,
  author,
  ws,
  ff,
  wrap = false,
  uppercase = false,
  lowercase = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  "quote",
  `quote--${variant}`,
  fs && `quote--size-${fs}`,
  tone && `quote--tone-${tone}`,
  xa && `quote--align-${xa}`,
  fw && `quote--weight-${fw}`,
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];



const styles = combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase });

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);

const Element = variant === "inline" ? "q" : "blockquote";
---

<Element class:list={finalClasses} style={finalStyles} cite={cite} {...rest}>
  <slot />
  {author && variant !== 'inline' && (
    <footer class="quote__footer">
      <cite class="quote__cite">{author}</cite>
    </footer>
  )}
</Element>
