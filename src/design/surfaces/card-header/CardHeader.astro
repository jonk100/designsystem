---
/**
 * src/design/surfaces/card-header/CardHeader.astro
 * The top section of a Card component.
 * - Owns its own padding (top, left, right, and a smaller bottom padding).
 * - Allows independent background coloring and optional bottom border.
 * @props (local): as, padding, borderBottom
 * @props (global): class, class:list, animate, onScroll, bg
 */
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import type { SurfaceComponentProps } from "@/design/surfaces/surfaces.types";
import { SURFACE_PADDING_CLASS_MAP } from "@/design/surfaces/surfaces.maps";
import { BACKGROUND_TONE_CLASS_MAP } from "@/design/shared/maps";
import './CardHeader.css';

export interface Props extends SurfaceComponentProps {
  borderBottom?: boolean;
}

const {
  as: Tag = 'div',
  padding = 'default',
  bg,
  borderBottom = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'card-header-component',
  padding && SURFACE_PADDING_CLASS_MAP[padding as keyof typeof SURFACE_PADDING_CLASS_MAP],
  borderBottom && 'card-header--border-bottom',
  bg && BACKGROUND_TONE_CLASS_MAP[bg as keyof typeof BACKGROUND_TONE_CLASS_MAP]
];
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles('', Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>