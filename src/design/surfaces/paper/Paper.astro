---
/**
 * src/design/surfaces/paper/Paper.astro
 * A regional document surface sitting just above the page floor (--layer--1).
 * - Serves as a subtly lifted container for main content areas or editor canvases.
 * - Distinct from Card as it acts more as a zone or region rather than a discrete object.
 * @props (local): as, elevation, padding
 * @props (global): class, class:list, animate, onScroll
 * - elevation: Controls the visual lift, defaulting to 'sm'.
 * - padding: Internal space of the paper surface, handled by the component.
 */
import type { SpacingScale } from "@/design/shared";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import type { BaseComponentProps } from "@/design/shared/props";
import './Paper.css';

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"div">, keyof BaseComponentProps> {
  elevation?: 'none' | 'sm' | 'md' | 'lg' | 'xl';
  padding?: SpacingScale;
}

const {
  as: Tag = 'div',
  elevation = 'sm',
  padding = 'sm',
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'paper-component',
  `paper-elevation--${elevation}`,
  `paper-padding--${padding}`
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles('', Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>
