---
/**
 * src/design/surfaces/well/Well.astro
 * A recessed surface, visual inverse of a Card.
 * - Sinks into the page rather than lifting above it.
 * - Used for code blocks, nested content, and read-only fields.
 * @props (local): as, layer, padding
 * @props (global): class, class:list, animate, onScroll, bg
 */
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import type { SurfaceComponentProps } from "@/design/surfaces/surfaces.types";
import { SURFACE_PADDING_CLASS_MAP } from "@/design/surfaces/surfaces.maps";
import { BACKGROUND_TONE_CLASS_MAP } from "@/design/shared/maps";
import '@/design/surfaces/surfaces.css';
import './Well.css';

export interface Props extends SurfaceComponentProps {
}

const {
  as: Tag = 'div',
  layer = 1,
  padding = 'md',
  bg,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'well-component',
  `surface-layer--${layer}`,
  SURFACE_PADDING_CLASS_MAP[padding as keyof typeof SURFACE_PADDING_CLASS_MAP],
  bg && BACKGROUND_TONE_CLASS_MAP[bg as keyof typeof BACKGROUND_TONE_CLASS_MAP]
];
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles('', Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>
