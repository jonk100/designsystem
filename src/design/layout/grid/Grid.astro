---
/**
 * src/design/layout/grid/Grid.astro
 * A layout primitive that arranges its children in a multi-column CSS grid.
 * - Used for building responsive, two-dimensional layouts where elements align across rows and columns.
 * - Supports configurable column counts, responsive wrapping, and standardized gaps.
 * @props (local): as, columns, gap, minWidth
 * @props (global): class, class:list, animate, onScroll, effects, frame
 */

import type { BaseComponentProps } from "@/design/shared/props";
import type { SpacingScale } from "@/design/shared/types";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import './Grid.css';

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"div">, keyof BaseComponentProps> {
  columns?: string | number;
  gap?: SpacingScale;
  minWidth?: string;
}

const {
  as: Tag = 'div',
  columns,
  gap = 'xl',
  minWidth = '280px',
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'grid-component',
  columns ? 'grid-component--explicit' : undefined,
  gap && `gap-${gap}`
];

const customStyle = columns 
  ? `--grid-cols: ${columns};` 
  : `grid-template-columns: repeat(auto-fit, minmax(${minWidth}, 1fr));`;

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(customStyle, Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>
