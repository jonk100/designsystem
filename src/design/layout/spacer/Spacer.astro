---
import type { AnimationProps, SpacingScale } from '../../shared';
import { mergeClasses, mergeStyles } from '../../shared';

export interface Props extends AnimationProps {
  /** Spacing size */
  size?: SpacingScale;
  /** Direction of spacing */
  direction?: 'horizontal' | 'vertical' | 'both';
  /** HTML element to render */
  as?: 'div' | 'span';
  /** Additional CSS classes */
  class?: string;
  "class:list"?: Record<string, boolean> | any[];
  style?: string | Record<string, string | number>;
  [key: string]: any;
}

const {
  size = 'lg',
  direction = 'vertical',
  as: Tag = 'div',
  ...rest
} = Astro.props;

// Define component-specific classes
const classes = [
  'spacer',
  `spacer--${direction}--${size}`,
];

const styles = '';

// Merge with animation and received props
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<Tag
  class:list={finalClasses}
  style={finalStyles}
  aria-hidden="true"
  {...rest}
/>

<style>
  .spacer {
    display: block;
    flex-shrink: 0;
  }

  /* Vertical spacing (default) */
  .spacer--vertical--2xs { width: 100%; height: var(--space-2xs); }
  .spacer--vertical--xs { width: 100%; height: var(--space-xs); }
  .spacer--vertical--sm { width: 100%; height: var(--space-sm); }
  .spacer--vertical--md { width: 100%; height: var(--space-md); }
  .spacer--vertical--lg { width: 100%; height: var(--space-lg); }
  .spacer--vertical--xl { width: 100%; height: var(--space-xl); }
  .spacer--vertical--2xl { width: 100%; height: var(--space-2xl); }
  .spacer--vertical--3xl { width: 100%; height: var(--space-3xl); }
  .spacer--vertical--4xl { width: 100%; height: var(--space-4xl); }

  /* Horizontal spacing */
  .spacer--horizontal--2xs { display: inline-block; height: 100%; width: var(--space-2xs); }
  .spacer--horizontal--xs { display: inline-block; height: 100%; width: var(--space-xs); }
  .spacer--horizontal--sm { display: inline-block; height: 100%; width: var(--space-sm); }
  .spacer--horizontal--md { display: inline-block; height: 100%; width: var(--space-md); }
  .spacer--horizontal--lg { display: inline-block; height: 100%; width: var(--space-lg); }
  .spacer--horizontal--xl { display: inline-block; height: 100%; width: var(--space-xl); }
  .spacer--horizontal--2xl { display: inline-block; height: 100%; width: var(--space-2xl); }
  .spacer--horizontal--3xl { display: inline-block; height: 100%; width: var(--space-3xl); }
  .spacer--horizontal--4xl { display: inline-block; height: 100%; width: var(--space-4xl); }

  /* Both directions */
  .spacer--both--2xs { width: var(--space-2xs); height: var(--space-2xs); }
  .spacer--both--xs { width: var(--space-xs); height: var(--space-xs); }
  .spacer--both--sm { width: var(--space-sm); height: var(--space-sm); }
  .spacer--both--md { width: var(--space-md); height: var(--space-md); }
  .spacer--both--lg { width: var(--space-lg); height: var(--space-lg); }
  .spacer--both--xl { width: var(--space-xl); height: var(--space-xl); }
  .spacer--both--2xl { width: var(--space-2xl); height: var(--space-2xl); }
  .spacer--both--3xl { width: var(--space-3xl); height: var(--space-3xl); }
  .spacer--both--4xl { width: var(--space-4xl); height: var(--space-4xl); }
</style>