---
/**
 * src/design/layout/spacer/Spacer.astro
 * A layout primitive used to create empty space between components.
 * - Used to push content apart or add precise vertical/horizontal margins within Flex or Grid containers.
 * - Supports responsive sizing utilizing `--sp-*` variables.
 * @props (local): size, direction, as
 * @props (global): class, class:list, animate, onScroll, effects, frame
 */

import type { BaseComponentProps } from "../../shared/props";
import type { SpacingScale } from '../../shared/types';
import { mergeClasses, mergeStyles } from '../../shared/functions';
import './Spacer.css';

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"div">, keyof BaseComponentProps> {
  /** Spacing size */
  size?: SpacingScale;
  /** Direction of spacing */
  direction?: 'horizontal' | 'vertical' | 'both';
  /** HTML element to render */
  as?: 'div' | 'span';
}

const {
  size = 'lg',
  direction = 'vertical',
  as: Tag = 'div',
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

// Define component-specific classes
const classes = [
  'spacer',
  direction === 'horizontal' && 'spacer--horizontal',
];

// Dynamically compute width and height using central --sp- custom spacing variables
const spacingVal = `var(--sp-${size}, 1rem)`;
const inlineStyle = direction === 'vertical'
  ? `width: 100%; height: ${spacingVal};`
  : direction === 'horizontal'
    ? `height: 100%; width: ${spacingVal};`
    : `width: ${spacingVal}; height: ${spacingVal};`;

// Merge with animation and received props
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(inlineStyle, Astro.props);
---

<Tag
  class:list={finalClasses}
  style={finalStyles}
  aria-hidden="true"
  {...rest}
/>