---
/**
 * src/design/layout/stack/Stack.astro
 * A vertical flexbox container (column).
 * - Enforces vertical stacking of child elements.
 * - Supports responsive gaps and dynamic X/Y alignment.
 * @props (local): as, gap, x, y
 * @props (global): class, class:list, animate, onScroll, and other HTML attributes
 */
import type { BaseComponentProps } from "@/design/shared/props";
import type { LayoutAlign, SpacingScale } from "@/design/shared/types";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import { LAYOUT_ALIGN_MAP } from "@/design/layout/maps";
import type { HTMLAttributes } from "astro/types";
import './Stack.css';

export interface Props extends BaseComponentProps, Omit<HTMLAttributes<'div'>, keyof BaseComponentProps> {
  gap?: SpacingScale;
  /** Horizontal alignment (maps to align-items in column flex) */
  x?: LayoutAlign;
  /** Vertical alignment (maps to justify-content in column flex) */
  y?: LayoutAlign;
}

const {
  as: Tag = 'div',
  gap = 'md',
  x = 'stretch',
  y = 'start',
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'stack-component',
  gap && `gap-${gap}`
];

// For Stack (flex-direction: column), x is align-items and y is justify-content
const flexStyles = [
  x && `align-items: ${LAYOUT_ALIGN_MAP[x]}`,
  y && `justify-content: ${LAYOUT_ALIGN_MAP[y]}`
].filter(Boolean).join(';');

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(flexStyles, Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>
