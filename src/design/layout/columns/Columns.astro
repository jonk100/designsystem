---
/**
 * src/design/layout/columns/Columns.astro
 * A layout primitive that formats text and children into multi-column CSS layouts.
 * - Utilizes CSS Multi-column layout properties (column-count, column-gap, column-width).
 * - Ideal for article text flows, newspaper-style layout lists, or flexible Masonry-like structures.
 * @props (local): as, count, gap, width, rule
 * @props (global): class, class:list, animate, onScroll, effects, frame
 */

import type { SpacingScale } from "@/design/shared/types";
import type { ColumnsRule } from "@/design/layout/types";
import type { BaseComponentProps } from "@/design/shared/props";
import { mergeClasses, mergeStyles } from "@/design/shared/functions";
import "./Columns.css";

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"div">, keyof BaseComponentProps> {
  /** Number of columns */
  count?: number | string;
  /** Gap spacing between columns */
  gap?: SpacingScale;
  /** Minimum width for columns */
  width?: string;
  /** Column rule / divider line configuration */
  rule?: ColumnsRule;
}

const {
  as: Tag = "div",
  count,
  gap = "lg",
  width,
  rule = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = ["columns-component"];

// Build dynamic inline style values using modern multi-column properties
const colCount = count ? `column-count: ${count};` : "";
const colWidth = width ? `column-width: ${width};` : "";
const colGap = gap ? `column-gap: var(--sp-${gap}, 1rem);` : "";
const colRule = rule === true
  ? "column-rule: 1px solid var(--color-border, rgba(148, 163, 184, 0.15));"
  : typeof rule === "string"
    ? `column-rule: ${rule};`
    : "";

const customStyle = [colCount, colWidth, colGap, colRule].filter(Boolean).join(" ");

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(customStyle, Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>
