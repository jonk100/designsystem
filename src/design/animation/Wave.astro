---
import { mergeClasses, mergeStyles } from "../shared/functions";
import type { BaseComponentProps } from "../shared/props";

export interface Props extends BaseComponentProps {
  display?: "block" | "inline" | "inline-block" | "contents";
  [key: string]: any;
}

const standardProps = [
  "as",
  "class",
  "class:list",
  "style",
  "id",
  "display",
  "animate",
  "onScroll",
];
const props = Astro.props;

let animationName = "";
let animationValue = "";

for (const [key, value] of Object.entries(props)) {
  if (!standardProps.includes(key) && value !== false && value !== undefined) {
    animationName = key;
    animationValue = typeof value === "string" ? value : "";
    break;
  }
}

const animate = animationName
  ? `${animationName} ${animationValue}`.trim()
  : Astro.props.animate;

// Extract base delay if provided in the string
let baseDelayMs = 100; // default 100ms
if (animate) {
  const parts = animate.split(/\s+/);
  for (const part of parts) {
    if (part.startsWith("delay-")) {
      const val = part.replace("delay-", "");
      if (val.endsWith("ms")) baseDelayMs = parseFloat(val);
      else if (val.endsWith("s")) baseDelayMs = parseFloat(val) * 1000;
    }
  }
}

const { as: Tag = "div", display = "block", onScroll, ...rest } = props;

if (onScroll) {
  rest['data-on-scroll'] = "wave";
}

if (animationName) {
  delete rest[animationName];
}

// Ensure the name is added so animate.css `.wave--[name] > *` rule targets the children
const parsedName = animate ? animate.split(/\s+/)[0] : "";
const classes = [
  "wave-component",
  display && `wave-display--${display}`,
  parsedName && `wave--${parsedName}`,
];

// Generate a unique ID for this instance to scope the child delays
const uniqueId = Math.random().toString(36).slice(2, 11);
classes.push(`wave-instance-${uniqueId}`);

// We do NOT pass `animate` to mergeClasses because we don't want the `.animate--` class on the container itself!
// The container should NOT animate. Only its children should.
const finalClasses = mergeClasses(classes, { ...props, animate: undefined });
const finalStyles = mergeStyles("", { ...props, animate: undefined });

// Generate the cascading delay CSS for up to 30 children
let delayCSS = "";
let currentDelay = baseDelayMs;
for (let i = 1; i <= 30; i++) {
  delayCSS += `.wave-instance-${uniqueId} > *:nth-child(${i}) { animation-delay: ${Math.round(currentDelay)}ms !important; }\n`;
  currentDelay *= 1.5;
}
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Tag>

<style set:html={delayCSS}></style>

<style>
  .wave-display--block {
    display: block;
  }
  .wave-display--inline {
    display: inline;
  }
  .wave-display--inline-block {
    display: inline-block;
  }
  .wave-display--contents {
    display: contents;
  }

  /* Prevent FOUC for entrance animations by hiding children before the animation starts */
  .wave-component[class*="wave--fadeIn"] > *,
  .wave-component[class*="wave--slideIn"] > *,
  .wave-component[class*="wave--scaleIn"] > * {
    animation-fill-mode: both !important;
  }
</style>
