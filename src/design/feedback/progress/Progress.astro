---
/**
 * src/design/feedback/progress/Progress.astro
 * A visual indicator showing completion status for workflows.
 * - Supports sizes: sm, md, lg.
 * - Supports indeterminate sliding states when value is undefined.
 * @props (local): value, max, size, variant, label, showValue
 * @props (global): class, class:list, animate, effects, bg, style
 */
import type { FeedbackSeverity, FeedbackSize } from "../feedback.types";
import type { BaseComponentProps } from "../../shared/props";
import { mergeClasses, mergeStyles } from "../../shared/functions";
import Text from "../../typography/text/Text.astro";
import "./Progress.css";

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"div">, keyof BaseComponentProps> {
  /** The progress value (0 to max). If undefined, component enters indeterminate state. */
  value?: number;
  /** The maximum progress limit */
  max?: number;
  /** Size of progress bar height */
  size?: FeedbackSize;
  /** Color theme variant */
  variant?: FeedbackSeverity;
  /** Descriptive loading label */
  label?: string;
  /** Whether to show completion percentage text */
  showValue?: boolean;
}

const {
  value,
  max = 100,
  size = "md",
  variant = "info",
  label,
  showValue = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const isIndeterminate = value === undefined;
const percentage = isIndeterminate ? 0 : Math.min(100, Math.max(0, (value / max) * 100));

const classes = [
  "progress-component",
  `progress-size--${size}`,
  `progress-variant--${variant}`,
  isIndeterminate && "is-indeterminate",
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(isIndeterminate ? "" : `--progress-value: ${percentage}%;`, Astro.props);
---

<div
  class:list={finalClasses}
  style={finalStyles}
  role="progressbar"
  aria-valuenow={value}
  aria-valuemin="0"
  aria-valuemax={max}
  aria-label={label}
  {...rest}
>
  {label && (
    <div class="progress__header">
      <Text class="progress__label" bold fs="2">{label}</Text>
      {showValue && !isIndeterminate && (
        <Text class="progress__value" tone="muted" fs="2">{Math.round(percentage)}%</Text>
      )}
    </div>
  )}
  <div class="progress__track">
    <div class="progress__bar"></div>
  </div>
</div>
