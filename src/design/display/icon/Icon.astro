---
/**
 * src/design/display/icon/Icon.astro
 * A primitive wrapper to dynamically load and render Astro SVG components.
 * - Enforces 1:1 aspect ratio.
 * - Inlines the SVG using Astro's native component support.
 * @props (local): name, size, tone
 * @props (global): class, class:list, animate, onScroll, effects, HTML attributes
 */

import type { BaseComponentProps } from "../../shared/props";
import type { DisplaySize, TextTone } from "../../shared/types";
import { mergeClasses, mergeStyles } from "../../shared/functions";
import { DISPLAY_VAR_MAP } from "../maps";
import { icons, type SvgName } from "../../shared/icons/index";
import './Icon.css';

export interface Props extends BaseComponentProps, Omit<import("astro/types").HTMLAttributes<"svg">, keyof BaseComponentProps> {
  /** The icon identifier */
  name: SvgName;
  /** Size of the icon */
  size?: DisplaySize;
  /** Color tone of the icon */
  tone?: TextTone;
}

const {
  name,
  size = "md",
  tone = "inherit",
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

// Lookup the SVG component from the generated registry
const SvgComponent = icons[name];

const classes = [
  "icon-component",
  `text-tone--${tone}`
];

const styles = [
  size && DISPLAY_VAR_MAP.size(size)
].filter(Boolean).join(';');

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);

// If the icon name doesn't exist, we don't render anything (could throw an error, but fallback is safer for UI)
---
{SvgComponent && (
  <SvgComponent
    class:list={finalClasses}
    style={finalStyles}
    aria-hidden="true"
    {...rest as any}
  />
)}
