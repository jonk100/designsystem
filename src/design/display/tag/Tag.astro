---
import type { TagProps } from './Tag.props';
import { buildStyles, mergeClasses, mergeStyles } from "@/design/shared/functions";
import Inline from "@/design/layout/inline/Inline.astro";
import Dot from "@/design/display/dot/Dot.astro";
import Icon from "@/design/display/icon/Icon.astro";
import { icons, type SvgName } from "@/design/shared/icons/index";
import { DISPLAY_VAR_MAP } from '../maps';
import "./Tag.css";

type Props = TagProps;
const { icon, variant = "default", size = "md", dot = false, as: TagElement = "span", class: className, 'class:list': classList, style, ...rest } = Astro.props;

const isSvgIcon = icon && icon in icons;

const classes = [
  "tag-component"
];

const customStyles = buildStyles([
  size && DISPLAY_VAR_MAP.size(size),
  variant && DISPLAY_VAR_MAP.variant(variant as any)
]);

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(customStyles, Astro.props);
---
<Inline as={TagElement} gap="xs" class:list={finalClasses} style={finalStyles} {...rest}>
  {dot && <Dot variant={variant as any} size="2xs" class="tag__dot" />}
  {icon && (
    <span class="tag--icon">
      {isSvgIcon ? (
        <Icon name={icon as SvgName} size={size} />
      ) : (
        icon
      )}
    </span>
  )}
  <span class="tag--text"><slot /></span>
</Inline>
