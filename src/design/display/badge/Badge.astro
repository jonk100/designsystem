---
import type { BadgeProps } from './Badge.props';
import { buildStyles, mergeClasses, mergeStyles } from "@/design/shared/functions";
import Inline from "@/design/layout/inline/Inline.astro";
import Icon from "@/design/display/icon/Icon.astro";
import { icons, type SvgName } from "@/design/shared/icons/index";
import { DISPLAY_VAR_MAP } from '../maps';
import "./Badge.css";

type Props = BadgeProps;
const { 
  icon, 
  variant = "default", 
  size = "md", 
  as: Tag = "span", 
  class: className, 
  'class:list': classList, 
  style, 
  ...rest 
} = Astro.props;

const isSvgIcon = icon && icon in icons;

const classes = [
  "badge-component"
];

const styles = buildStyles([
  size && DISPLAY_VAR_MAP.size(size),
  variant && DISPLAY_VAR_MAP.variant(variant)
]);

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---
<Inline
  as={Tag} 
  gap="sm" 
  class:list={finalClasses} 
  style={finalStyles} 
  {...rest}
>
  {icon && (
    <span class="badge--icon">
      {isSvgIcon ? (
        <Icon name={icon as SvgName} size={size} />
      ) : (
        icon
      )}
    </span>
  )}
  <span class="badge--text">
    <slot />
  </span>
</Inline>