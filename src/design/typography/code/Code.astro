---
/**
 * src/design/typography/code/Code.astro
 * A component for rendering inline or block code snippets.
 * - Supports both inline `<code>` and block `<pre><code>` structures.
 * - Allows syntax highlighting context via the `language` prop.
 * @props (local): size, tone, block, language, weight, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import type { FontSize, TextTone, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { FontWeight, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import '../typography.css';
import './Code.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'code'>, keyof BaseComponentProps> {
  /**
   * Font size of the code
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Display as a block (pre-formatted)
   */
  block?: boolean;
  
  /**
   * Programming language (for syntax highlighting context)
   */
  language?: string;
  
  /**
   * Font weight
   */
  fw?: string;
  
  /**
   * Standard boolean typography styles
   */
}

const {
  fs,
  tone,
  block = false,
  language,
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'code',
  fs && `code--size-${fs}`,
  tone && `code--tone-${tone}`,
  block && 'code--block',
  fw && `code--weight-${fw}`,
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
  className,
];



const styles = combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase });

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);

const Element = block ? 'pre' : 'code';
---

{block ? (
  <pre class:list={finalClasses} style={finalStyles} data-language={language} {...rest}>
    <code><slot /></code>
  </pre>
) : (
  <code class:list={finalClasses} style={finalStyles} data-language={language} {...rest}>
    <slot />
  </code>
)}