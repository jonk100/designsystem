---
/**
 * src/design/typography/code/Code.astro
 * A component for rendering inline or block code snippets.
 * - Supports both inline `<code>` and block `<pre><code>` structures.
 * - Allows syntax highlighting context via the `language` prop.
 * @props (local): size, tone, block, language, weight, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '@/design/shared/props';
import type { TypographyProps } from '@/design/typography/types';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '@/design/shared/functions';
import { STYLE_VAR_MAP } from '@/design/shared/maps';
import '@/design/typography/typography.css';
import './Code.css';

export interface Props extends BaseComponentProps, TypographyProps, Omit<HTMLAttributes<'code'>, keyof BaseComponentProps | keyof TypographyProps> {
  /**
   * Display as a block (pre-formatted)
   */
  block?: boolean;
  
  /**
   * Programming language (for syntax highlighting context)
   */
  language?: string;
}

const {
  fs,
  tone,
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  block = false,
  language,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'code-component',
  block && 'code--block',
  language && `language-${language}`,
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];

const typographyVars = [
  fs && STYLE_VAR_MAP.fontSize(fs),
  fw && STYLE_VAR_MAP.fontWeight(fw),
  tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
  typographyVars,
  combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);


---

{block ? (
  <pre class:list={finalClasses} style={finalStyles} data-language={language} {...rest}>
    <code><slot /></code>
  </pre>
) : (
  <code class:list={finalClasses} style={finalStyles} data-language={language} {...rest}>
    <slot />
  </code>
)}