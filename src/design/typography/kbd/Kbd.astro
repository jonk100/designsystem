---
/**
 * src/design/typography/kbd/Kbd.astro
 * A component to denote keyboard input or shortcuts.
 * - Displays monospaced keyboard keys.
 * - Configurable sizes, tones, and font weights.
 * @props (local): size, tone, weight, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import type { TypographyProps } from '../types';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import { STYLE_VAR_MAP } from '../../shared/maps';
import '../typography.css';
import './Kbd.css';

export interface Props extends BaseComponentProps, TypographyProps, Omit<HTMLAttributes<'kbd'>, keyof BaseComponentProps | keyof TypographyProps> {
}

const {
  fs,
  tone,
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'kbd-component',
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];

const typographyVars = [
  fs && STYLE_VAR_MAP.fontSize(fs),
  fw && STYLE_VAR_MAP.fontWeight(fw),
  tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
  typographyVars,
  combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);
---

<kbd class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</kbd>