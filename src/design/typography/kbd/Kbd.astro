---
import type { FontSize, TextTone } from '../typography.types';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'kbd'> {
  /**
   * Font size of the kbd
   */
  size?: FontSize;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Font weight
   */
  weight?: 'thin' | 'extralight' | 'light' | 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold' | 'black';
}

const {
  size,
  tone,
  weight,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'kbd',
  size && `kbd--size-${size}`,
  tone && `kbd--tone-${tone}`,
  weight && `kbd--weight-${weight}`,
  className,
].filter(Boolean).join(' ');
---

<kbd class={classes} {...rest}>
  <slot />
</kbd>

<style>
  @import '../typography.css';
  @import './Kbd.css';
</style>