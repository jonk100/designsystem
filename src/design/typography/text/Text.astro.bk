---
/**
 * src/design/typography/text/Text.astro
 * A versatile inline text component.
 * - Provides low-level control over various typography tokens.
 * - Dynamically changes its underlying HTML element based on the `as` prop.
 * - NEVER responsible for layout, margin, padding, etc. The space around Text belongs to its parent.
 * @props (local): fs, tone, align, valign, weight, transform, leading, tracking, truncate, clamp, as, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import { TextTags } from './';
import type {
    FontSize,
    TextTone,
    XAlign,
    YAlign,
    LineHeight,
    LetterSpacing,
    FontFamily,
    WhiteSpace,
    BlockType,
    FontStyleProps,
} from "../../shared/types";
import {
    getFontSizeClass,
    TEXT_TONE_CLASS_MAP,
    X_ALIGN_CLASS_MAP,
    Y_ALIGN_CLASS_MAP,
} from "../../shared/maps";
import type { BaseComponentProps } from "../../shared/props";
import {
    mergeClasses,
    mergeStyles,
    combineFontStyleProps,
} from "../../shared/functions";
import type { HTMLAttributes } from "astro/types";
import "../typography.css";
import "./Text.css";

export interface Props
    extends
        BaseComponentProps,
        FontStyleProps,
        Omit<HTMLAttributes<"span">, keyof BaseComponentProps> {
    fs?: FontSize;
    tone?: TextTone;
    xa?: XAlign;
    ya?: YAlign;
    fw?: string; // e.g. "bold", "500"
    lh?: LineHeight;
    ls?: LetterSpacing;
    ws?: WhiteSpace;
    ff?: FontFamily;
    wrap?: boolean;
    truncate?: boolean;
    clamp?: number;
    as?: BlockType;
}

const {
    fs = "3",
    tone,
    xa,
    ya,
    fw,
    bold = false,
    italic = false,
    underline = false,
    strikethrough = false,
    uppercase = false,
    lowercase = false,
    lh,
    ls,
    ws,
    ff,
    wrap = false,
    truncate = false,
    clamp,
    as: Tag = "span",
    class: className,
    'class:list': classList,
    style,
    ...rest
} = Astro.props;

// Define component-specific classes and styles
const classes = [
    "text-component",
    fs && getFontSizeClass(fs as FontSize),
    tone && TEXT_TONE_CLASS_MAP[tone as TextTone],
    xa && X_ALIGN_CLASS_MAP[xa as XAlign],
    ya && Y_ALIGN_CLASS_MAP[ya as YAlign],
    fw && `font-${fw}`,
    lh && `leading-${lh}`,
    ls && `tracking-${ls}`,
    ws && `whitespace-${ws}`,
    ff && `font-${ff}`,
    wrap && "break-words",
    truncate && "truncate",
    clamp !== undefined && `line-clamp-${clamp}`,
    className,
];

const styles = combineFontStyleProps({
    bold,
    italic,
    underline,
    strikethrough,
    uppercase,
    lowercase,
});

// Merge with animation and received props
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
    <slot />
</Tag>
