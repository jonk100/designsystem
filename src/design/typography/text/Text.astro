---
/**
 * src/design/typography/text/Text.astro
 * A versatile inline text component.
 * - Provides low-level control over various typography tokens.
 * - Dynamically changes its underlying HTML element based on the `as` prop.
 * - NEVER responsible for layout, margin, padding, etc. The space around Text belongs to its parent.
 * @props (local): truncate, clamp, wrap, as
 * @props (global): class, class:list, animate, onScroll, fs, tone, align, valign, weight, transform, leading, tracking, bold, italic, underline, strikethrough
 */
import type { TextTag } from './Text.types';
import type { BaseComponentProps } from "../../shared/props";
import type { TypographyProps } from "../types";
import {
    X_ALIGN_CLASS_MAP,
    Y_ALIGN_CLASS_MAP,
    STYLE_VAR_MAP,
} from "../../shared/maps";
import {
    mergeClasses,
    mergeStyles,
    combineFontStyleProps,
} from "../../shared/functions";
import type { HTMLAttributes } from "astro/types";
import "../typography.css";
import "./Text.css";

export interface Props
    extends
        BaseComponentProps,
        TypographyProps,
        Omit<HTMLAttributes<"span">, keyof BaseComponentProps | keyof TypographyProps> {
    wrap?: boolean;
    truncate?: boolean;
    clamp?: number;
    as?: TextTag;
}

const {
    fs = "3",
    tone,
    xa,
    ya,
    fw,
    bold = false,
    italic = false,
    underline = false,
    strikethrough = false,
    uppercase = false,
    lowercase = false,
    lh = `${fs}`,
    ls = `${fs}`,
    ws,
    ff,
    wrap = false,
    truncate = false,
    clamp,
    as: Tag = "span",
    class: className,
    'class:list': classList,
    style,
    ...rest
} = Astro.props;

// Define component-specific classes and styles
const classes = [
    "text-component",
    xa && X_ALIGN_CLASS_MAP[xa],
    ya && Y_ALIGN_CLASS_MAP[ya],
    ws && `whitespace-${ws}`,
    ff && `font-${ff}`,
    wrap && "break-words",
    truncate && "truncate",
    clamp !== undefined && `line-clamp-${clamp}`,
];

const typographyVars = [
    fs && STYLE_VAR_MAP.fontSize(fs),
    fw && STYLE_VAR_MAP.fontWeight(fw),
    lh && STYLE_VAR_MAP.leading(lh),
    ls && STYLE_VAR_MAP.tracking(ls),
    tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
    typographyVars,
    combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

// Merge with animation and received props
const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);
---

<Tag class:list={finalClasses} style={finalStyles} {...rest}>
    <slot />
</Tag>
