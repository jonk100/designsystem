---
/**
 * src/design/typography/caption/Caption.astro
 * A caption component used to describe or contextualize media content.
 * - Supports different semantic elements and typography scales.
 * - Can be styled with different tones, weights, and alignments.
 * @props (local): as, size, tone, align, weight, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '@/design/shared/props';
import type { TypographyProps } from '@/design/typography/types';
import type { CaptionElement } from '@/design/typography/types';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '@/design/shared/functions';
import { STYLE_VAR_MAP, X_ALIGN_CLASS_MAP } from '@/design/shared/maps';
import '@/design/typography/typography.css';
import './Caption.css';

export interface Props extends BaseComponentProps, TypographyProps, Omit<HTMLAttributes<'figcaption'>, keyof BaseComponentProps | keyof TypographyProps> {
  /**
   * The HTML element to render
   * @default 'figcaption'
   */
  as?: CaptionElement;
}

const {
  as: Element = 'figcaption',
  fs = 'sm',
  tone = 'muted',
  xa,
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'caption-component',
  xa && X_ALIGN_CLASS_MAP[xa],
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];

const typographyVars = [
  fs && STYLE_VAR_MAP.fontSize(fs),
  fw && STYLE_VAR_MAP.fontWeight(fw),
  tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
  typographyVars,
  combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);
---

<Element class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Element>