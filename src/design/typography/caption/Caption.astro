---
/**
 * src/design/typography/caption/Caption.astro
 * A caption component used to describe or contextualize media content.
 * - Supports different semantic elements and typography scales.
 * - Can be styled with different tones, weights, and alignments.
 * @props (local): as, size, tone, align, weight, bold, italic, underline, strikethrough
 * @props (global): class, class:list, animate, onScroll
 */
import type { FontSize, TextTone, XAlign, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { CaptionElement } from '../types';
import type { FontWeight, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import '../typography.css';
import './Caption.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'figcaption'>, keyof BaseComponentProps> {
  /**
   * The HTML element to render
   * @default 'figcaption'
   */
  as?: CaptionElement;
  
  /**
   * Font size of the caption
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Horizontal text alignment
   */
  xa?: XAlign;
  
  /**
   * Font weight
   */
  fw?: string;
  
  /**
   * Standard boolean typography styles
   */
}

const {
  as: Element = 'figcaption',
  fs = 'sm',
  tone = 'muted',
  xa,
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'caption',
  fs && `caption--size-${fs}`,
  tone && `caption--tone-${tone}`,
  xa && `caption--align-${xa}`,
  fw && `caption--weight-${fw}`,
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
  className,
];



const styles = combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase });

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<Element class:list={finalClasses} style={finalStyles} {...rest}>
  <slot />
</Element>