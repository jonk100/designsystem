---
/**
 * src/design/typography/link/Link.astro
 * A link component for navigation.
 * - Custom underlining behavior on hover or active states.
 * - External link indicator support.
 * @props (local): href, size, tone, weight, bold, italic, underline, strikethrough, external, target, rel
 * @props (global): class, class:list, animate, onScroll
 */
import type { FontSize, TextTone, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { FontWeight, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import '../typography.css';
import './Link.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'a'>, keyof BaseComponentProps> {
  /**
   * URL to link to
   */
  href?: string;
  
  /**
   * Font size of the link
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Font weight
   */
  fw?: string;
  
  /**
   * Standard boolean typography styles
   */
  
  /**
   * External link (opens in new tab)
   */
  external?: boolean;
  
  /**
   * Target attribute
   */
  target?: string;
  
  /**
   * Rel attribute
   */
  rel?: string;
}

const {
  href,
  fs,
  tone = 'primary',
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  external = false,
  target = external ? '_blank' : undefined,
  rel = external ? 'noopener noreferrer' : undefined,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'link',
  fs && `link--size-${fs}`,
  tone && `link--tone-${tone}`,
  fw && `link--weight-${fw}`,
  external && 'link--external',
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
  className,
];



const textDeco = underline && strikethrough ? 'underline line-through' : underline ? 'underline' : strikethrough ? 'line-through' : null;

const styles = [
    bold && `font-weight: bold`,
    italic && `font-style: italic`,
    textDeco && `text-decoration: ${textDeco}`,
]
    .filter(Boolean)
    .join(";");

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<a class:list={finalClasses} style={finalStyles} href={href} target={target} rel={rel} {...rest}>
  <slot />
  {external && <span class="link__external-icon" aria-hidden="true">↗</span>}
</a>