---
/**
 * src/design/typography/link/Link.astro
 * A link component for navigation.
 * - Custom underlining behavior on hover or active states.
 * - External link indicator support.
 * @props (local): href, size, tone, weight, bold, italic, underline, strikethrough, external, target, rel
 * @props (global): class, class:list, animate, onScroll
 */
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import type { TypographyProps } from '../types';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import { STYLE_VAR_MAP } from '../../shared/maps';
import '../typography.css';
import './Link.css';

export interface Props extends BaseComponentProps, TypographyProps, Omit<HTMLAttributes<'a'>, keyof BaseComponentProps | keyof TypographyProps> {
  /**
   * URL to link to
   */
  href?: string;
  
  /**
   * External link (opens in new tab)
   */
  external?: boolean;
  
  /**
   * Target attribute
   */
  target?: string;
  
  /**
   * Rel attribute
   */
  rel?: string;
}

const {
  href,
  fs,
  tone = 'primary',
  fw,
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  external = false,
  target = external ? '_blank' : undefined,
  rel = external ? 'noopener noreferrer' : undefined,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'link-component',
  external && 'link--external',
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];

const typographyVars = [
  fs && STYLE_VAR_MAP.fontSize(fs),
  fw && STYLE_VAR_MAP.fontWeight(fw),
  tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
  typographyVars,
  combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);
---

<a class:list={finalClasses} style={finalStyles} href={href} target={target} rel={rel} {...rest}>
  <slot />
  {external && <span class="link__external-icon" aria-hidden="true">↗</span>}
</a>