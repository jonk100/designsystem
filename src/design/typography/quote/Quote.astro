---
import type { FontSize, TextTone, XAlign } from '../typography.types';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'q'> {
  /**
   * Font size of the quote
   */
  size?: FontSize;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Horizontal text alignment
   */
  align?: XAlign;
  
  /**
   * Font weight
   */
  weight?: 'thin' | 'extralight' | 'light' | 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold' | 'black';
  
  /**
   * Font style
   */
  italic?: boolean;
  
  /**
   * Citation URL
   */
  cite?: string;
}

const {
  size,
  tone,
  align,
  weight,
  italic = true,
  cite,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'quote',
  size && `quote--size-${size}`,
  tone && `quote--tone-${tone}`,
  align && `quote--align-${align}`,
  weight && `quote--weight-${weight}`,
  italic && 'quote--italic',
  className,
].filter(Boolean).join(' ');
---

<q class={classes} cite={cite} {...rest}>
  <slot />
</q>

<style>
  @import '../typography.css';
  @import './Quote.css';
</style>