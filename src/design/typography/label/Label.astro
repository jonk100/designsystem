---
import type { FontSize, TextTone } from '../typography.types';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'label'> {
  /**
   * Font size of the label
   */
  size?: FontSize;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Font weight
   */
  weight?: 'thin' | 'extralight' | 'light' | 'normal' | 'medium' | 'semibold' | 'bold' | 'extrabold' | 'black';
  
  /**
   * Required field indicator
   */
  required?: boolean;
  
  /**
   * Disabled state
   */
  disabled?: boolean;
  
  /**
   * Associated input id
   */
  for?: string;
}

const {
  size,
  tone,
  weight = 'medium',
  required = false,
  disabled = false,
  for: htmlFor,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'label',
  size && `label--size-${size}`,
  tone && `label--tone-${tone}`,
  weight && `label--weight-${weight}`,
  required && 'label--required',
  disabled && 'label--disabled',
  className,
].filter(Boolean).join(' ');
---

<label class={classes} for={htmlFor} {...rest}>
  <slot />
  {required && <span class="label__required" aria-label="required">*</span>}
</label>

<style>
  @import '../typography.css';
  @import './Label.css';
</style>