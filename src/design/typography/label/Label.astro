---
/**
 * src/design/typography/label/Label.astro
 * A label component for form elements.
 * - Supports variable font sizes, tones, and weights.
 * - Can display a required indicator and a disabled state.
 * @props (local): size, tone, weight, bold, italic, underline, strikethrough, required, disabled, for
 * @props (global): class, class:list, animate, onScroll
 */
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '@/design/shared/props';
import type { TypographyProps } from '@/design/typography/types';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '@/design/shared/functions';
import { STYLE_VAR_MAP } from '@/design/shared/maps';
import '@/design/typography/typography.css';
import './Label.css';

export interface Props extends BaseComponentProps, TypographyProps, Omit<HTMLAttributes<'label'>, keyof BaseComponentProps | keyof TypographyProps> {
  /**
   * Required field indicator
   */
  required?: boolean;
  
  /**
   * Optional field indicator
   */
  optional?: boolean;
  
  /**
   * Disabled state
   */
  disabled?: boolean;
  
  /**
   * Associated input id
   */
  for?: string;
}

const {
  fs,
  tone,
  fw = 'medium',
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  required = false,
  optional = false,
  disabled = false,
  for: htmlFor,
  class: className,
  'class:list': classList,
  style,
  ...rest
} = Astro.props;

const classes = [
  'label-component',
  required && 'label--required',
  disabled && 'label--disabled',
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
];

const typographyVars = [
  fs && STYLE_VAR_MAP.fontSize(fs),
  fw && STYLE_VAR_MAP.fontWeight(fw),
  tone && STYLE_VAR_MAP.tone(tone)
].filter(Boolean).join(';');

const styles = [
  typographyVars,
  combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase })
];

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles.filter(Boolean).join(';'), Astro.props);
---

<label class:list={finalClasses} style={finalStyles} for={htmlFor} {...rest}>
  <slot />
  {required && <span class="label__required" aria-label="required">*</span>}
  {optional && <span class="label__optional">(optional)</span>}
</label>