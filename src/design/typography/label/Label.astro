---
/**
 * src/design/typography/label/Label.astro
 * A label component for form elements.
 * - Supports variable font sizes, tones, and weights.
 * - Can display a required indicator and a disabled state.
 * @props (local): size, tone, weight, bold, italic, underline, strikethrough, required, disabled, for
 * @props (global): class, class:list, animate, onScroll
 */
import type { FontSize, TextTone, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { FontWeight, FontFamily, WhiteSpace, FontStyleProps } from "../../shared/types";
import type { HTMLAttributes } from 'astro/types';
import type { BaseComponentProps } from '../../shared/props';
import { mergeClasses, mergeStyles, combineFontStyleProps } from '../../shared/functions';
import '../typography.css';
import './Label.css';

interface Props extends BaseComponentProps, FontStyleProps, Omit<HTMLAttributes<'label'>, keyof BaseComponentProps> {
  /**
   * Font size of the label
   */
  fs?: FontSize;
  ws?: WhiteSpace;
  ff?: FontFamily;
  wrap?: boolean;
  
  /**
   * Color tone of the text
   */
  tone?: TextTone;
  
  /**
   * Font weight
   */
  fw?: string;
  
  /**
   * Standard boolean typography styles
   */
  
  /**
   * Required field indicator
   */
  required?: boolean;
  
  /**
   * Disabled state
   */
  disabled?: boolean;
  
  /**
   * Associated input id
   */
  for?: string;
}

const {
  fs,
  tone,
  fw = 'medium',
  bold = false,
  italic = false,
  underline = false,
  strikethrough = false,
  uppercase = false,
  lowercase = false,
  ws,
  ff,
  wrap = false,
  required = false,
  disabled = false,
  for: htmlFor,
  class: className,
  ...rest
} = Astro.props;

const classes = [
  'label',
  fs && `label--size-${fs}`,
  tone && `label--tone-${tone}`,
  fw && `label--weight-${fw}`,
  required && 'label--required',
  disabled && 'label--disabled',
  ws && `whitespace-${ws}`,
  ff && `font-${ff}`,
  wrap && "break-words",
  className,
];



const styles = combineFontStyleProps({ bold, italic, underline, strikethrough, uppercase, lowercase });

const finalClasses = mergeClasses(classes, Astro.props);
const finalStyles = mergeStyles(styles, Astro.props);
---

<label class:list={finalClasses} style={finalStyles} for={htmlFor} {...rest}>
  <slot />
  {required && <span class="label__required" aria-label="required">*</span>}
</label>