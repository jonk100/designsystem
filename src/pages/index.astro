---
import Text from "../design/typography/text/Text.astro";
import Code from "../design/typography/code/Code.astro";
import Link from "../design/typography/link/Link.astro";
import Caption from "../design/typography/caption/Caption.astro";
import Label from "../design/typography/label/Label.astro";
import Kbd from "../design/typography/kbd/Kbd.astro";
import Inline from "../design/layout/inline/Inline.astro";
import Stack from "../design/layout/stack/Stack.astro";
import Grid from "../design/layout/grid/Grid.astro";
import Container from "../design/layout/container/Container.astro";
import Center from "../design/layout/center/Center.astro";
import Spacer from "../design/layout/spacer/Spacer.astro";
import Card from "../design/surfaces/card/Card.astro";
import Paper from "../design/surfaces/paper/Paper.astro";
import Collapsible from "../design/controls/collapsible/Collapsible.astro";
import Badge from "../design/display/badge/Badge.astro";
import Tag from "../design/display/tag/Tag.astro";
import Avatar from "../design/display/avatar/Avatar.astro";
import Icon from "../design/display/icon/Icon.astro";
import Indicator from "../design/display/indicator/Indicator.astro";
import Dot from "../design/display/dot/Dot.astro";
import Chip from "../design/display/chip/Chip.astro";
import Counter from "../design/display/counter/Counter.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Home">
	<Container size="xl">
		<Stack gap="2xl">
			<!-- Page Header -->
			<Stack gap="sm">
				<Text as="p" fs="5xl" bold>The System</Text>
				<Text as="p" fs="lg" tone="muted">
					Layout primitives, surfaces, and typography — composed together.
				</Text>
			</Stack>

			<!-- ─── SECTION: Stack ─────────────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Stack</Text>
				<Text as="p" fs="sm" tone="muted">
					Vertical flex column. Children stack top to bottom with a consistent
					gap.
				</Text>
				<Text as="p" italic fs="2xs">Nested inside a grid:</Text>

				<Grid columns={2} gap="lg">
					<!-- Example: gap sizes -->
					<Card padding="lg">
						<Stack gap="2xs">
							<Text fs="sm" tone="muted" bold>gap="xs"</Text>
							<Stack gap="xs" bg="2">
								<Paper padding="sm"><Text fs="sm">Item 1</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Item 2</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Item 3</Text></Paper>
							</Stack>
						</Stack>
					</Card>

					<Paper padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>gap="xl"</Text>
							<Stack gap="xl" bg="2">
								<Paper padding="sm"><Text fs="sm">Item 1</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Item 2</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Item 3</Text></Paper>
							</Stack>
						</Stack>
					</Paper>

					<!-- Example: alignment -->
					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>x="center"</Text>
							<Stack gap="sm" x="center" bg="2" style="min-height: 120px;">
								<Paper padding="sm"><Text fs="sm">Centered child</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Also centered</Text></Paper>
							</Stack>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>x="end"</Text>
							<Stack gap="sm" x="end" bg="2" style="min-height: 120px;">
								<Paper padding="sm"><Text fs="sm">Pushed right</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Also right</Text></Paper>
							</Stack>
						</Stack>
					</Card>
				</Grid>
			</Stack>

			<!-- ─── SECTION: Inline ────────────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Inline</Text>
				<Text as="p" fs="sm" tone="muted">
					Horizontal flex row. Children flow left to right, wrapping by default.
				</Text>

				<Grid columns={2} gap="lg">
					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>gap="md" (default wrap)</Text>
							<Inline gap="md" bg="2">
								<Paper padding="sm"><Text fs="sm">Alpha</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Beta</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Gamma</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Delta</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Epsilon</Text></Paper>
							</Inline>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>x="between" y="center"</Text>
							<Inline
								gap="md"
								x="between"
								y="center"
								bg="2"
								style="padding: 0.5rem;"
							>
								<Paper padding="sm"><Text fs="sm">Left</Text></Paper>
								<Paper padding="sm"><Text fs="lg">Tall</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Right</Text></Paper>
							</Inline>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>x="center"</Text>
							<Inline gap="sm" x="center" bg="2">
								<Paper padding="sm"><Text fs="sm">A</Text></Paper>
								<Paper padding="sm"><Text fs="sm">B</Text></Paper>
								<Paper padding="sm"><Text fs="sm">C</Text></Paper>
							</Inline>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>x="end"</Text>
							<Inline gap="sm" x="end" bg="2">
								<Paper padding="sm"><Text fs="sm">X</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Y</Text></Paper>
								<Paper padding="sm"><Text fs="sm">Z</Text></Paper>
							</Inline>
						</Stack>
					</Card>
				</Grid>
			</Stack>

			<!-- ─── SECTION: Container ─────────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Container</Text>
				<Text as="p" fs="sm" tone="muted">
					Constrains max-width and centers content. Provides safe side padding.
				</Text>

				<Stack gap="md">
					<Card padding="lg">
						<Stack gap="sm">
							<Text fs="sm" tone="muted" bold>size="sm" (640px)</Text>
							<Container size="sm" bg="3">
								<Paper padding="md">
									<Text fs="sm"
										>Content constrained to 640px max-width, centered with auto
										margins.</Text
									>
								</Paper>
							</Container>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="sm">
							<Text fs="sm" tone="muted" bold>size="md" (768px)</Text>
							<Container size="md" bg="3">
								<Paper padding="md">
									<Text fs="sm"
										>Medium container — 768px max. Good for article content.</Text
									>
								</Paper>
							</Container>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="sm">
							<Text fs="sm" tone="muted" bold>size="fluid" (no max)</Text>
							<Container size="fluid" bg="3">
								<Paper padding="md">
									<Text fs="sm"
										>Fluid — fills available width. The default.</Text
									>
								</Paper>
							</Container>
						</Stack>
					</Card>
				</Stack>
			</Stack>

			<!-- ─── SECTION: Grid ──────────────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Grid</Text>
				<Text as="p" fs="sm" tone="muted">
					CSS Grid layout. Set explicit columns or auto-fit with a min width.
				</Text>

				<Card padding="lg">
					<Stack gap="sm">
						<Text fs="sm" tone="muted" bold>columns={3} gap="md"</Text>
						<Grid columns={3} gap="md">
							<Paper padding="md"><Text fs="sm">Column 1</Text></Paper>
							<Paper padding="md"><Text fs="sm">Column 2</Text></Paper>
							<Paper padding="md"><Text fs="sm">Column 3</Text></Paper>
							<Paper padding="md"><Text fs="sm">Column 4</Text></Paper>
							<Paper padding="md"><Text fs="sm">Column 5</Text></Paper>
							<Paper padding="md"><Text fs="sm">Column 6</Text></Paper>
						</Grid>
					</Stack>
				</Card>

				<Card padding="lg">
					<Stack gap="sm">
						<Text fs="sm" tone="muted" bold>Auto-fit (minWidth="200px")</Text>
						<Grid minWidth="200px" gap="md">
							<Paper padding="md"><Text fs="sm">Auto A</Text></Paper>
							<Paper padding="md"><Text fs="sm">Auto B</Text></Paper>
							<Paper padding="md"><Text fs="sm">Auto C</Text></Paper>
							<Paper padding="md"><Text fs="sm">Auto D</Text></Paper>
							<Paper padding="md"><Text fs="sm">Auto E</Text></Paper>
						</Grid>
					</Stack>
				</Card>
			</Stack>

			<!-- ─── SECTION: Center ────────────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Center</Text>
				<Text as="p" fs="sm" tone="muted">
					Flexbox centering utility — both axes by default.
				</Text>

				<Grid columns={2} gap="lg">
					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>Default (both axes)</Text>
							<Center bg="2" style="height: 150px;">
								<Paper padding="md"><Text fs="sm">Dead center</Text></Paper>
							</Center>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="xs">
							<Text fs="sm" tone="muted" bold>text={true}</Text>
							<Center text bg="2" style="height: 150px;">
								<Text as="p" fs="sm">Text is centered too</Text>
								<Text as="p" fs="sm" tone="muted">Second line</Text>
							</Center>
						</Stack>
					</Card>
				</Grid>
			</Stack>

			<!-- ─── SECTION: Paper & Card ──────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Paper & Card</Text>
				<Text as="p" fs="sm" tone="muted">
					Surface components for grouping content. Cards have hover effects,
					Papers are neutral containers.
				</Text>

				<Grid columns={3} gap="lg">
					<Stack gap="sm">
						<Text fs="sm" tone="muted" bold>Paper (sm padding)</Text>
						<Paper padding="sm">
							<Text fs="sm"
								>A lightweight container with minimal chrome. Good for wrapping
								small groups of related elements.</Text
							>
						</Paper>
					</Stack>

					<Stack gap="sm">
						<Text fs="sm" tone="muted" bold>Paper (lg padding)</Text>
						<Paper padding="lg">
							<Text fs="sm"
								>More breathing room. Works well for standalone sections or as
								inner containers within a Card.</Text
							>
						</Paper>
					</Stack>

					<Stack gap="sm">
						<Text fs="sm" tone="muted" bold>Card (default)</Text>
						<Card padding="lg">
							<Stack gap="sm">
								<Text fs="lg" bold>Card Title</Text>
								<Text fs="sm" tone="muted"
									>Cards get a hover lift and glow. Try hovering.</Text
								>
							</Stack>
						</Card>
					</Stack>
				</Grid>
			</Stack>

			<!-- ─── SECTION: Text ──────────────────────────────── -->
			<Collapsible gap="xl">
				<Stack as="span" gap="xs" slot="summary">
					<Text as="span" fs="2xl" bold>Text</Text>
					<Text as="span" fs="sm" tone="muted">
						Typography primitive. Controls size, weight, tone, letter-spacing,
						and decoration.
					</Text>
				</Stack>

				<Stack gap="md">

					<Card padding="lg">
						<Stack gap="md">
							<!-- Size scale -->
							<Stack gap="xs">
								<Text fs="sm" tone="muted" bold>Size scale</Text>
								<Inline gap="md" y="baseline">
									<Text fs="xs">xs</Text>
									<Text fs="sm">sm</Text>
									<Text fs="md">md</Text>
									<Text fs="lg">lg</Text>
									<Text fs="xl">xl</Text>
									<Text fs="2xl">2xl</Text>
									<Text fs="3xl">3xl</Text>
								</Inline>
							</Stack>

							<!-- Tones -->
							<Stack gap="xs">
								<Text fs="sm" tone="muted" bold>Tones</Text>
								<Inline gap="md">
									<Text tone="default">default</Text>
									<Text tone="muted">muted</Text>
									<Text tone="subtle">subtle</Text>
									<Text tone="primary">primary</Text>
									<Text tone="secondary">secondary</Text>
									<Text tone="accent">accent</Text>
									<Text tone="success">success</Text>
									<Text tone="danger">danger</Text>
								</Inline>
							</Stack>

							<!-- Weight -->
							<Stack gap="xs">
								<Text fs="sm" tone="muted" bold>Weights</Text>
								<Inline gap="md">
									<Text fs="sm" fw="light">light</Text>
									<Text fs="sm" fw="normal">normal</Text>
									<Text fs="sm" fw="medium">medium</Text>
									<Text fs="sm" fw="semibold">semibold</Text>
									<Text fs="sm" bold>bold</Text>
									<Text fs="sm" fw="extrabold">extrabold</Text>
								</Inline>
							</Stack>

							<!-- Decorations -->
							<Stack gap="xs">
								<Text fs="sm" tone="muted" bold>Decorations</Text>
								<Inline gap="md">
									<Text italic>italic</Text>
									<Text underline>underline</Text>
									<Text strikethrough>strikethrough</Text>
									<Text uppercase fs="sm">uppercase</Text>
									<Text lowercase fs="sm">LOWERCASE</Text>
								</Inline>
							</Stack>
						</Stack>
					</Card>
				</Stack>
			</Collapsible>

			<!-- ─── SECTION: Typography Components ────────────────── -->
			<Collapsible gap="xl">
				<Stack as="span" gap="xs" slot="summary">
					<Text as="span" fs="2xl" bold>Typography Components</Text>
					<Text as="span" fs="sm" tone="muted">
						Role-based text wrappers built on the Typography primitive (Code, Link, Caption, Label, Kbd).
					</Text>
				</Stack>

				<Stack gap="md">
					<Grid columns={2} gap="lg">
						<Card padding="lg">
							<Stack gap="sm">
								<Text fs="sm" tone="muted" bold>Caption</Text>
								<Caption fs="sm" tone="subtle" xa="center">
									This is a caption, often used below media or figures.
								</Caption>
							</Stack>
						</Card>

						<Card padding="lg">
							<Stack gap="sm">
								<Text fs="sm" tone="muted" bold>Label</Text>
								<Label for="example" required fs="sm" fw="medium">Email Address</Label>
								<Label for="example-disabled" disabled fs="sm" fw="medium">Password</Label>
							</Stack>
						</Card>

						<Card padding="lg">
							<Stack gap="sm">
								<Text fs="sm" tone="muted" bold>Code & Kbd</Text>
								<Inline gap="sm" y="center">
									<Code fs="sm">npm install</Code>
									<Text fs="sm" tone="muted">or press</Text>
									<Inline gap="2xs" y="center">
										<Kbd>Ctrl</Kbd> <Text fs="sm" tone="muted">+</Text> <Kbd>C</Kbd>
									</Inline>
								</Inline>
							</Stack>
						</Card>

						<Card padding="lg">
							<Stack gap="sm">
								<Text fs="sm" tone="muted" bold>Link</Text>
								<Inline gap="md" wrap>
									<Link href="#">Internal Link</Link>
									<Link href="https://example.com" external>External Link</Link>
								</Inline>
							</Stack>
						</Card>
					</Grid>
				</Stack>
			</Collapsible>

			<!-- ─── SECTION: Display ─────────────────────────── -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Display</Text>
					<Text as="p" fs="sm" tone="muted">
						Visual elements for communicating status, counts, and metadata.
					</Text>
				</Stack>

				<Stack gap="md">
					<Card padding="lg">
						<Stack gap="md">
							<Text fs="sm" tone="muted" bold>Badge & Tag</Text>
							<Inline gap="sm" y="center">
								<Badge variant="primary">New Feature</Badge>
								<Badge variant="success">Active</Badge>
								<Badge variant="danger">Error</Badge>
								<Tag size="sm">v2.4.0</Tag>
								<Tag variant="warning" size="md">Beta</Tag>
							</Inline>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="md">
							<Text fs="sm" tone="muted" bold>Avatar, Counter, & Indicators</Text>
							<Inline gap="md" y="center">
								<Avatar size="lg" src="https://i.pravatar.cc/150?u=1" alt="User 1" />
								<Avatar size="md" src="https://i.pravatar.cc/150?u=2" alt="User 2" />
								<Inline gap="xs" y="center">
									<Dot variant="success" />
									<Text fs="sm" tone="muted">Online</Text>
								</Inline>
								<Counter variant="primary">42</Counter>
								<Counter variant="danger">99+</Counter>
								<Chip>Clickable Chip</Chip>
							</Inline>
						</Stack>
					</Card>
				</Stack>
			</Collapsible>

			<!-- ─── SECTION: Composition ───────────────────────── -->
			<Stack gap="md">
				<Text as="p" fs="2xl" bold>Composition</Text>
				<Text as="p" fs="sm" tone="muted">
					Primitives compose together. Here's a realistic card layout built from
					Stack, Inline, Text, and Card.
				</Text>

				<Grid columns={3} gap="lg">
					<Card padding="lg">
						<Stack gap="md">
							<Inline gap="sm" y="center">
								<Text fs="2xl">📊</Text>
								<Text fs="lg" bold>Analytics</Text>
							</Inline>
							<Stack gap="xs">
								<Inline gap="sm" x="between">
									<Text fs="sm" tone="muted">Users</Text>
									<Text fs="sm" bold>42,819</Text>
								</Inline>
								<Inline gap="sm" x="between">
									<Text fs="sm" tone="muted">Sessions</Text>
									<Text fs="sm" bold>128,403</Text>
								</Inline>
								<Inline gap="sm" x="between">
									<Text fs="sm" tone="muted">Bounce Rate</Text>
									<Text fs="sm" bold>24.3%</Text>
								</Inline>
							</Stack>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="md">
							<Inline gap="sm" y="center">
								<Text fs="2xl">🚀</Text>
								<Text fs="lg" bold>Deployment</Text>
							</Inline>
							<Stack gap="xs">
								<Text fs="sm" tone="success">● Production — Healthy</Text>
								<Text fs="sm" tone="muted">● Staging — Idle</Text>
								<Text fs="sm" tone="muted">● Preview — Building</Text>
							</Stack>
							<Text fs="xs" tone="subtle">Last deployed 3 minutes ago</Text>
						</Stack>
					</Card>

					<Card padding="lg">
						<Stack gap="md">
							<Inline gap="sm" y="center">
								<Text fs="2xl">🎨</Text>
								<Text fs="lg" bold>Design Tokens</Text>
							</Inline>
							<Inline gap="xs">
								<Paper padding="sm"
									><Text fs="xs" tone="muted">--sp-xs</Text></Paper
								>
								<Paper padding="sm"
									><Text fs="xs" tone="muted">--sp-sm</Text></Paper
								>
								<Paper padding="sm"
									><Text fs="xs" tone="muted">--sp-md</Text></Paper
								>
								<Paper padding="sm"
									><Text fs="xs" tone="muted">--sp-lg</Text></Paper
								>
								<Paper padding="sm"
									><Text fs="xs" tone="muted">--sp-xl</Text></Paper
								>
							</Inline>
							<Text fs="xs" tone="subtle">5 spacing tokens in active use</Text>
						</Stack>
					</Card>
				</Grid>
			</Stack>

			<!-- Footer spacer -->
			<Spacer size="xl" />
		</Stack>
	</Container>
</Layout>
