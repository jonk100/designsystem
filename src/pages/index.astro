<script>
	const setupThemeToggles = () => {
		const colorsSwitch = document.querySelector('[data-name="classic-colors"]') as HTMLButtonElement;
		const fontsSwitch = document.querySelector('[data-name="classic-fonts"]') as HTMLButtonElement;

		if (colorsSwitch) {
			colorsSwitch.addEventListener("click", () => {
				const checked = colorsSwitch.getAttribute("aria-checked") === "true";
				const nextChecked = !checked;
				colorsSwitch.setAttribute("aria-checked", nextChecked.toString());
				colorsSwitch.classList.toggle("is-checked", nextChecked);
				document.documentElement.classList.toggle("classic-colors", nextChecked);
			});
		}

		if (fontsSwitch) {
			fontsSwitch.addEventListener("click", () => {
				const checked = fontsSwitch.getAttribute("aria-checked") === "true";
				const nextChecked = !checked;
				fontsSwitch.setAttribute("aria-checked", nextChecked.toString());
				fontsSwitch.classList.toggle("is-checked", nextChecked);
				document.documentElement.classList.toggle("classic-fonts", nextChecked);
			});
		}
	};

	setupThemeToggles();
	document.addEventListener("astro:page-load", setupThemeToggles);
</script>
