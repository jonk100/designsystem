---
/**
 * src/pages/index.astro
 * Main entry page for The System design system showcase.
 * Integrates modular showcase sections to keep the index page maintainable and lightweight.
 */
import Text from "@/design/typography/text/Text.astro";
import Stack from "@/design/layout/stack/Stack.astro";
import Container from "@/design/layout/container/Container.astro";
import Spacer from "@/design/layout/spacer/Spacer.astro";
import Layout from "@/layouts/Layout.astro";
import Collapsible from "@/design/controls/collapsible/Collapsible.astro";

// Import modular showcase sections
import ThemeCustomizer from "@/components/sections/ThemeCustomizer.astro";
import ControlsShowcase from "@/components/sections/ControlsShowcase.astro";
import DisplayShowcase from "@/components/sections/DisplayShowcase.astro";
import TypographyShowcase from "@/components/sections/TypographyShowcase.astro";
import LayoutShowcase from "@/components/sections/LayoutShowcase.astro";
import SurfacesShowcase from "@/components/sections/SurfacesShowcase.astro";
import FeedbackShowcase from "@/components/sections/FeedbackShowcase.astro";
import OverlaysShowcase from "@/components/sections/OverlaysShowcase.astro";
import CompositionShowcase from "@/components/sections/CompositionShowcase.astro";
import Icon from "@/design/display/icon/Icon.astro";
---

<Layout title="Home">
	<Container size="xl">

		<Stack gap="2xl">
			<!-- Page Header -->
			<Stack gap="sm">
				<Text as="p" fs="5xl" bold>The System</Text>
				<Text as="p" fs="lg" tone="muted">
					Layout primitives, surfaces, and typography — composed together.
				</Text>
			</Stack>

			<!-- Theme Configuration Dashboard -->
			<ThemeCustomizer />

			<!-- Controls & Pickers Showcase -->
			<Collapsible gap="xl" open>
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Controls & Inputs</Text>
					<Text as="p" fs="sm" tone="muted">
						Interactive components: sliders, select pickers, inputs, checkable controls, and buttons.
					</Text>
				</Stack>
				<ControlsShowcase />
			</Collapsible>

			<!-- Display Elements Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Display</Text>
					<Text as="p" fs="sm" tone="muted">
						Visual elements for communicating status, counts, tags, metadata, and user avatars.
					</Text>
				</Stack>
				<DisplayShowcase />
			</Collapsible>

			<!-- Typography Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Typography & Semantics</Text>
					<Text as="p" fs="sm" tone="muted">
						Text styling, sizing scales, weight modifiers, links, semantic quotes, code wrappers, and labels.
					</Text>
				</Stack>
				<TypographyShowcase />
			</Collapsible>

			<!-- Layout Primitives Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Layout Primitives</Text>
					<Text as="p" fs="sm" tone="muted">
						Structural components for building page grids, vertical stacks, horizontal lines, containers, and centered blocks.
					</Text>
				</Stack>
				<LayoutShowcase />
			</Collapsible>

			<!-- Surfaces & Containers Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Surfaces</Text>
					<Text as="p" fs="sm" tone="muted">
						Structural containers that group, elevate, and outline content layout sections.
					</Text>
				</Stack>
				<SurfacesShowcase />
			</Collapsible>

			<!-- Feedback (Alerts & Toasts) Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Feedback</Text>
					<Text as="p" fs="sm" tone="muted">
						Inline messages and floating notifications to communicate status, errors, warning alerts, and success events.
					</Text>
				</Stack>
				<FeedbackShowcase />
			</Collapsible>

			<!-- Overlays (Modals, Drawers, Sheets, Palettes, Context Menus) Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Overlays</Text>
					<Text as="p" fs="sm" tone="muted">
						Positioned popups, centered dialogs, edge drawers, command palettes, context menus, tooltips, and popovers.
					</Text>
				</Stack>
				<OverlaysShowcase />
			</Collapsible>

			<!-- Realistic Layout Composition Showcase -->
			<Collapsible gap="xl">
				<Stack gap="xs" slot="summary">
					<Text as="p" fs="2xl" bold>Composition</Text>
					<Text as="p" fs="sm" tone="muted">
						Demonstrations of how layout primitives and surface components nest to form realistic UI patterns.
					</Text>
				</Stack>
				<CompositionShowcase />
			</Collapsible>

			<!-- Footer Spacer -->
			<Spacer size="xl" />
		</Stack>
	</Container>
</Layout>
